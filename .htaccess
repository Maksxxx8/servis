# ==============================================================================
# Beauty Studio CRM — Налаштування кешування та безпеки для Apache / LiteSpeed
# ==============================================================================

<IfModule mod_headers.c>
    # 1. ЗАБОРОНА КЕШУВАННЯ для сторінок, скриптів, стилів та API
    # Гарантує, що нові записи, переноси та правки коду оновлюються миттєво
    <FilesMatch "\.(html|htm|php|js|css|json)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
    </FilesMatch>

    # 2. ДОВГЕ КЕШУВАННЯ СТАТИКИ (Зображення, Шрифти, Іконки) на 30 днів
    # Зменшує трафік та прискорює повторне завантаження картинок і шрифтів
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|eot)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>
</IfModule>

# 3. БЕЗПЕКА: заборона прямого перегляду бази даних та конфігураційних файлів
<FilesMatch "(database\.json|\.git|\.env)$">
    Order allow,deny
    Deny from all
</FilesMatch>
